PORT=8800

# MongoDB connection string (get a fresh one from Atlas - never reuse a leaked one)
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/gigflow

# Secret used to sign JWTs - generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_KEY=replace_this_with_a_long_random_string

CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Gmail (or SMTP) credentials for password-reset emails - use an App Password, not your real password
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Used by `npm run seed:admin` to create/reset the admin account.
ADMIN_EMAIL=admin@gigflow.com
ADMIN_PASSWORD=GigFlow@Admin2026!

# Razorpay (test mode keys start with rzp_test_) - get these from
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret
